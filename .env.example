# Copy to your environment (or a .env sourced by systemd) and fill in.
# The proxy reads these at startup. NEVER commit real keys to git.
#
# LLM proxy keys — each is a bearer key the client sends as
# `Authorization: Bearer <key>`. The role name is just a label for you.
FIF_AUTH_KEY_MOBIN=change-me-mobin
FIF_AUTH_KEY_NIRJHOR=change-me-nirjhor

# Admin key: authenticates /__dashboard and /__api/* (NOT an LLM key).
FIF_AUTH_ADMIN_KEY=change-me-admin

# Real freeinference.org credential. The proxy injects this upstream itself
# and never reveals it to callers. If unset, falls back to FREEINFERENCE_API_KEY.
FIF_UPSTREAM_KEY=change-me-upstream

# Also accepted as a proxy LLM key so the existing Hermes provider (which
# injects this) keeps working with no config change.
FREEINFERENCE_API_KEY=change-me-freeinference